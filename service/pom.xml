<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-artifacts</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The web half of this context: the JAX-RS boundary over the `artifacts` library
         (eu.wohlben.qits.artifacts.api) and the in-process JGit smart-HTTP git host
         (eu.wohlben.qits.githost, plain Vert.x routes at /git/*).

         A library JAR, not a deployable app — the same shape the monorepo packages `artifacts`/`ci`
         in, and the same shape qits-workspaces' `service` module has. A consuming Quarkus
         application pulls it in and gets the routes. Packaging it as an app would need an auth
         variant, a webui and a main class, none of which belong to this bounded context
         (migration-plan.md §9 item 7 tracks the same gap for qits-workspaces).

         Deliberately absent vs. the monorepo's `service`: quarkus-quinoa, quarkus-undertow (the git
         host is on Vert.x routes precisely to stay off the servlet stack), the MCP server tree, the
         OTLP receiver, websockets-next, vertx-http-proxy, and every auth/* module. -->
    <artifactId>qits-artifacts-service</artifactId>
    <name>qits-artifacts :: service</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-artifacts-artifacts</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- @Operation(hidden = true) on the wire/system controllers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- JGit core only (UploadPack/ReceivePack + the pkt-line protocol). GitHostRoutes
                 drives these directly from Vert.x routes, so we need NEITHER a servlet container
                 (quarkus-undertow) NOR jgit.http.server — undertow's presence breaks Quinoa's
                 production static serving in the consuming app (the monorepo's
                 docs/issues/2026-07-15_packaged-spa-not-served.md). JGit speaks the wire protocol
                 ONLY; the git CLI remains the sole mutator of repositories. -->
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
