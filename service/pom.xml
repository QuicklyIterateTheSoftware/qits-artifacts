<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-artifacts</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The web half of this context: the JAX-RS boundary over the `artifacts` library
         (eu.wohlben.qits.artifacts.api) and the in-process JGit smart-HTTP git host
         (eu.wohlben.qits.githost, plain Vert.x routes at /artifacts/git/*).

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the routes" — because packaging it would have needed an
         auth variant, a webui and a main class. All three reasons have lapsed: authentication
         terminates at qits-gateway and this module reads a header (see security/), the webui stays
         in the monorepo, and Quarkus supplies the main class.

         See migration-deployables-plan.md in the superproject.

         Deliberately absent vs. the monorepo's `service`: quarkus-quinoa, quarkus-undertow (the git
         host is on Vert.x routes precisely to stay off the servlet stack), the MCP server tree, the
         OTLP receiver, websockets-next, vertx-http-proxy, and every auth/* module. -->
    <artifactId>qits-artifacts-service</artifactId>
    <name>qits-artifacts :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-artifacts-artifacts</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- @Operation(hidden = true) on the wire/system controllers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- JGit core only (UploadPack/ReceivePack + the pkt-line protocol). GitHostRoutes
                 drives these directly from Vert.x routes, so we need NEITHER a servlet container
                 (quarkus-undertow) NOR jgit.http.server — undertow's presence breaks Quinoa's
                 production static serving in the consuming app (the monorepo's
                 docs/issues/2026-07-15_packaged-spa-not-served.md). JGit speaks the wire protocol
                 ONLY; the git CLI remains the sole mutator of repositories. -->
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar, and `<packaging>quarkus</packaging>`
                     above is what says so: it binds generate-code, generate-code-tests and build into
                     the lifecycle, so augmentation is not an execution someone can misplace. It was
                     one — and an <executions> block can silently fail to apply while `mvn verify`
                     stays green, which is exactly the failure qits-projects hit (a <testResources>
                     block ahead of <plugins> meant augmentation never ran). A packaging type cannot
                     fail that way: without this <extensions>true</extensions> the build stops at
                     "Unknown packaging: quarkus". Version comes from the root pom's
                     pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- The *IT suite runs against the PACKAGED artifact, which is the only place the
                     native binary can be exercised at all: @QuarkusTest runs on the JVM and a JGit
                     reflection gap does not show up there. Bound but skipped by default (skipITs in
                     the root pom); the `native` profile below flips it. -->
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- How @QuarkusIntegrationTest finds the compiled binary in a
                                     `-Dnative` build; without it the native run has nothing to
                                     launch. The name is `quarkus.package.output-name` in
                                     application.properties, NOT the maven finalName — the two have
                                     to be spelled the same or a native IT launches nothing and
                                     passes. -->
                                <native.image.path>${project.build.directory}/qits-artifacts</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the same profile qits-gateway and qits-workspace-daemon carry):
             `-Dnative` disables the fast-jar and enables the native image. It lives in THIS module,
             not the root pom, because only this module is an application — `artifacts` is a library
             jar and has nothing to native-compile. skipITs flips with it so a native build runs the
             @QuarkusIntegrationTest suite against the binary rather than skipping it silently. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
